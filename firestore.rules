rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users can read/write their own profile, but CANNOT change isAdmin
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // New users must have isAdmin = false (prevents self-promotion) and matching email
      allow create: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.data.isAdmin == false
        && request.resource.data.email == request.auth.token.email;
      // Existing users cannot change their isAdmin field or their email address
      allow update: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.email == resource.data.email;
    }

    // Tools are readable by all authenticated users; admins can create/delete; users can increment/decrement saves or flag tools
    match /tools/{toolId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null 
            && (
              // Users can only increment or decrement the saves count by exactly 1 on active/live tools
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saves'])
               && resource.data.status == 'live'
               && (request.resource.data.saves == resource.data.saves + 1 || request.resource.data.saves == resource.data.saves - 1))
              ||
              // Users can only update status to flagged when it was previously live
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
               && request.resource.data.status == 'flagged'
               && resource.data.status == 'live')
            ));
    }

    // Submissions: users can create their own and read their own; only admins can read all, update, or delete
    match /submissions/{submissionId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.submittedBy || isAdmin());
      // Users can only submit new tools with a status of 'pending' (prevents bypassing admin review)
      allow create: if request.auth != null 
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }
  }
}