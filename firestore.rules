rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────

    // Check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to format server timestamp as "yyyy-MM-dd" date string
    function getTodayStr() {
      let year = string(request.time.year());
      let month = request.time.month() < 10 ? '0' + string(request.time.month()) : string(request.time.month());
      let day = request.time.day() < 10 ? '0' + string(request.time.day()) : string(request.time.day());
      return year + '-' + month + '-' + day;
    }

    // Check if submission is under the daily limit
    function canSubmit(uid) {
      let userDoc = get(/databases/$(database)/documents/users/$(uid)).data;
      return !(userDoc.submissionsToday >= 3 && userDoc.lastSubmissionDate == getTodayStr());
    }

    // Validate string field length
    function isValidString(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    // ─── Users Collection ────────────────────────────────────

    match /users/{userId} {
      // Users can read their own profile; admins can read any profile
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // New users must have isAdmin = false (prevents self-promotion) and matching email
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.isAdmin == false
        && request.resource.data.email == request.auth.token.email
        && (!('isDeleted' in request.resource.data) || request.resource.data.isDeleted == false)
        && isValidString(request.resource.data.name, 100)
        && isValidString(request.resource.data.email, 254);

      // Existing users cannot change isAdmin or email unless they're an admin.
      // Also validate rate limiting increment and soft-delete transitions.
      allow update: if isAuthenticated()
        && (isAdmin() || (
             request.auth.uid == userId
             && request.resource.data.isAdmin == resource.data.get('isAdmin', false)
             && (request.resource.data.email == resource.data.email || (request.resource.data.get('isDeleted', false) == true && request.resource.data.email == ""))
             && (request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false) || (resource.data.get('isDeleted', false) == false && request.resource.data.get('isDeleted', false) == true))
             && (
               !(request.resource.data.get('submissionsToday', 0) != resource.data.get('submissionsToday', 0) || request.resource.data.get('lastSubmissionDate', '') != resource.data.get('lastSubmissionDate', ''))
               || (
                 request.resource.data.get('lastSubmissionDate', '') == getTodayStr()
                 && (
                   (resource.data.get('lastSubmissionDate', '') == request.resource.data.get('lastSubmissionDate', '') && request.resource.data.get('submissionsToday', 0) == resource.data.get('submissionsToday', 0) + 1)
                   || (resource.data.get('lastSubmissionDate', '') != request.resource.data.get('lastSubmissionDate', '') && request.resource.data.get('submissionsToday', 0) == 1)
                 )
               )
             )
           ));

      // Only admin can delete user documents (soft-delete is used for users)
      allow delete: if isAuthenticated() && isAdmin();
    }

    // ─── Tools Collection ────────────────────────────────────

    match /tools/{toolId} {
      // Any authenticated user can read live tools
      allow read: if isAuthenticated();

      // Only admins can create or delete tools
      allow create: if isAdmin()
        && isValidString(request.resource.data.name, 50)
        && isValidString(request.resource.data.description, 300);

      allow delete: if isAdmin();

      // Update rules: admin has full access; users can only do specific operations
      allow update: if isAdmin()
        || (isAuthenticated()
            && (
              // Users can only increment or decrement saves count by exactly 1 on live tools
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saves'])
               && resource.data.status == 'live'
               && (
                 (request.resource.data.saves == resource.data.saves + 1
                  && !(toolId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.savedTools))
                 ||
                 (request.resource.data.saves == resource.data.saves - 1
                  && (toolId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.savedTools))
               ))
              ||
              // Users can flag a live tool as 'flagged' for admin review
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
               && request.resource.data.status == 'flagged'
               && resource.data.status == 'live')
            ));
    }

    // ─── Submissions Collection ──────────────────────────────

    match /submissions/{submissionId} {
      // Users can read their own submissions; admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.submittedBy || isAdmin());

      // Users can create submissions with status 'pending' only, with validation
      allow create: if isAuthenticated()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && isValidString(request.resource.data.name, 50)
        && isValidString(request.resource.data.description, 300)
        && isValidString(request.resource.data.websiteUrl, 2048)
        && canSubmit(request.auth.uid);

      // Only admins can update or delete submissions
      allow update, delete: if isAdmin();
    }

    // ─── Deny all other collections ──────────────────────────
    // Prevent any reads/writes to collections not explicitly defined above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}