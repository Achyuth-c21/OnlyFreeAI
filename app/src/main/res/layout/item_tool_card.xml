<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardBackgroundColor="@color/background_card"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/card_padding">

        <!-- Tool Logo -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_tool_logo"
            android:layout_width="@dimen/logo_size_md"
            android:layout_height="@dimen/logo_size_md"
            android:scaleType="centerCrop"
            android:contentDescription="Tool logo"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Tool Name -->
        <TextView
            android:id="@+id/tv_tool_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_md"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="@dimen/spacing_md"
            app:layout_constraintStart_toEndOf="@id/img_tool_logo"
            app:layout_constraintEnd_toStartOf="@id/badge_verified"
            app:layout_constraintTop_toTopOf="@id/img_tool_logo" />

        <!-- Verified Badge -->
        <TextView
            android:id="@+id/badge_verified"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/verified_free"
            style="@style/Badge.Verified"
            android:visibility="gone"
            android:layout_marginStart="@dimen/spacing_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/img_tool_logo" />

        <!-- Description -->
        <TextView
            android:id="@+id/tv_tool_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_sm"
            android:textColor="@color/text_secondary"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_xs"
            app:layout_constraintStart_toEndOf="@id/img_tool_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_tool_name" />

        <!-- Spacer Divider -->
        <View
            android:id="@+id/divider_card"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="@dimen/spacing_md"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_tool_logo" />

        <!-- Category Tag -->
        <TextView
            android:id="@+id/tv_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/brand_primary"
            android:background="@drawable/bg_badge_verified"
            android:backgroundTint="@color/brand_primary_light"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="@dimen/spacing_md"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_card" />

        <!-- Saves Count -->
        <TextView
            android:id="@+id/tv_saves"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/text_secondary"
            android:drawablePadding="@dimen/spacing_xs"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_md"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_card"
            app:layout_constraintBottom_toBottomOf="@id/tv_category" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
