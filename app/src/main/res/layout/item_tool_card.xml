<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/bg_card"
    android:padding="@dimen/card_padding">

    <!-- Tool Logo -->
    <ImageView
        android:id="@+id/img_tool_logo"
        android:layout_width="@dimen/logo_size_md"
        android:layout_height="@dimen/logo_size_md"
        android:contentDescription="Tool logo"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tool Name -->
    <TextView
        android:id="@+id/tv_tool_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_md"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="@dimen/spacing_md"
        app:layout_constraintStart_toEndOf="@id/img_tool_logo"
        app:layout_constraintEnd_toStartOf="@id/badge_verified"
        app:layout_constraintTop_toTopOf="@id/img_tool_logo" />

    <!-- Verified Badge -->
    <TextView
        android:id="@+id/badge_verified"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/verified_free"
        style="@style/Badge.Verified"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/img_tool_logo" />

    <!-- Description -->
    <TextView
        android:id="@+id/tv_tool_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_sm"
        android:textColor="@color/text_secondary"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_xs"
        app:layout_constraintStart_toEndOf="@id/img_tool_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tool_name" />

    <!-- Category Tag -->
    <TextView
        android:id="@+id/tv_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_xs"
        android:textColor="@color/brand_green"
        android:background="@drawable/bg_badge_verified"
        android:backgroundTint="@color/brand_green_light"
        android:textStyle="bold"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:layout_marginTop="@dimen/spacing_sm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_tool_logo" />

    <!-- Saves Count -->
    <TextView
        android:id="@+id/tv_saves"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_xs"
        android:textColor="@color/text_hint"
        android:drawablePadding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_category"
        app:layout_constraintBottom_toBottomOf="@id/tv_category" />

</androidx.constraintlayout.widget.ConstraintLayout>
