<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark Theme Override -->
    <style name="Theme.OnlyFreeAI" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryDark">@color/brand_green_dark</item>
        <item name="colorAccent">@color/brand_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="android:statusBarColor">@color/background_primary</item>
        <item name="android:navigationBarColor">@color/background_primary</item>
        <item name="android:windowLightStatusBar">false</item>
